{
  "name": "@cycjimmy/jsmpeg-player",
  "type": "module",
  "version": "6.1.8",
  "description": "MPEG1 Video Player Based On JSMpeg",
  "browser": "dist/jsmpeg-player.umd.min.js",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/jsmpeg-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/jsmpeg-player.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/jsmpeg-player/issues"
  },
  "keywords": [
    "jsmpeg",
    "TS"
  ],
  "exports": {
    ".": {
      "import": "./dist/jsmpeg-player.esm.js",
      "default": "./dist/jsmpeg-player.esm.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "dist/jsmpeg-player.esm.js",
  "module": "dist/jsmpeg-player.esm.js",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "start": "npm run dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "test": "node --test",
    "dev": "vite",
    "build": "trash dist && npm run build:esm && npm run build:umd && npm run build:umd:min",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "build:deployment": "vite build --mode deployment && node tasks/copyPublishFiles.js",
    "package": "trash .release && npm run build && node tasks/copyFiles.js && node tasks/handlePackageJson.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cycjimmy/awesome-js-funcs": "^4.0.9",
    "@cycjimmy/sass-lib": "^4.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cycjimmy/config-lib": "^3.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.0.0",
    "fs-extra": "^11.2.0",
    "sass": "^1.77.8",
    "stylelint": "^17.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser": "^5.51.2",
    "trash-cli": "^7.2.0",
    "vite": "^8.3.5"
  }
}
